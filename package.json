{
  "name": "opencode-agentic-harness",
  "version": "0.2.0",
  "description": "Story-governed, bounded software project orchestration for OpenCode",
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "exports": "./index.js",
  "files": [
    "index.js",
    "src/",
    "templates/",
    "README.md",
    "docs/"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "agents",
    "harness",
    "project-governance"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.25"
  },
  "scripts": {
    "test": "node --test",
    "validate": "node scripts/validate-package.mjs",
    "check": "npm run validate && npm test",
    "test:recovery": "node --test tests/execution/process-recovery.test.js tests/execution/external-wait.test.js tests/execution/supervisor.test.js tests/execution/contract-correction.test.js tests/execution/retrospective-seed.test.js",
    "test:recovery:mutations": "node scripts/check-recovery-mutations.mjs"
  }
}
